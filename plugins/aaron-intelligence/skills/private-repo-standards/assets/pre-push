#!/bin/sh
#
# pre-push — refuse a direct push to the default branch.
#
# The only real prevention available on a private repo under GitHub Free, where
# rulesets and branch protection are Pro-gated. Installed by the
# private-repo-standards skill.
#
#   cp pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Per-clone, not per-repo. For every future clone:
#   git config --global init.templateDir ~/.git-templates
#   cp pre-push ~/.git-templates/hooks/pre-push
#
# Escape hatch, by design:  git push --no-verify

set -u

remote_name="${1:-origin}"

# Prefer the remote's own idea of HEAD; fall back to main, then master.
protected=$(git symbolic-ref --short "refs/remotes/${remote_name}/HEAD" 2>/dev/null \
              | sed "s#^${remote_name}/##")

if [ -z "${protected}" ]; then
  if git show-ref --verify --quiet refs/heads/main; then
    protected=main
  else
    protected=master
  fi
fi

status=0

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -n "${remote_ref}" ] || continue
  if [ "${remote_ref}" = "refs/heads/${protected}" ]; then
    printf 'pre-push: refusing direct push to %s on %s.\n' "${protected}" "${remote_name}" >&2
    printf '          Open a pull request instead:\n' >&2
    printf '            git switch -c my-change && git push -u %s my-change\n' "${remote_name}" >&2
    printf '          Override this once with: git push --no-verify\n' >&2
    status=1
  fi
done

exit "${status}"
